# Selera Sambal environment variables
# Copy this file to .env.local and fill in your values.

# PostgreSQL / Prisma (use the pooler URL for runtime queries)
DATABASE_URL=postgresql://<user>:<password>@<host>:6543/<db>?pgbouncer=true
DIRECT_URL=postgresql://<user>:<password>@<host>:5432/<db>

# Supabase client
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>

# AI
GEMINI_API_KEY=<your-gemini-api-key>

# JWT secret for table QR tokens (change in production)
JWT_SECRET=<your-jwt-secret>

# Public base URL encoded in table QR codes: <NEXT_PUBLIC_APP_URL>/t/<token>
# Production MUST be the permanent custom domain (not a preview or *.vercel.app URL),
# otherwise printed QR codes will break when the URL changes.
NEXT_PUBLIC_APP_URL=https://order.example.com

# Server-side key required by the admin table-management APIs (/api/admin/tables).
# Enter this once in Admin > Meja & QR. If unset: allowed in dev, rejected in production.
ADMIN_API_KEY=<long-random-string>
