# Selera Sambal environment variables
# Copy this file to .env.local and fill in your values.

# PostgreSQL / Prisma (use the pooler URL for runtime queries)
DATABASE_URL=
DIRECT_URL=

# Optional: only enable locally when you deliberately want the sample menu seeded.
# Do not set this in Vercel Production.
SEED_DEMO_DATA=

# Supabase (Server-side Storage / Admin)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase client (only public URL & anon/publishable key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI (Chatbot Groq — server-only)
GROQ_API_KEY=
CHATBOT_DAILY_LIMIT=

# JWT / Admin Session Secrets (server-only)
JWT_SECRET=
ADMIN_SESSION_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_API_KEY=

# Admin Initial Seed (minimal 12 karakter untuk password)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Public base URL encoded in table QR codes: <NEXT_PUBLIC_APP_URL>/m/<token>
NEXT_PUBLIC_APP_URL=

# Upstash Redis Rate Limiting (Free Tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile Anti-Bot
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
