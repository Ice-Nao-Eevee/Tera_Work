# ─── Selera Sambal — Environment Variables Example ───
# Copy this file to .env.local and fill in your values.
# Switching from local → Atlas is just an env-var change; no code changes needed.

# Local MongoDB (testing/development)
MONGODB_URI=mongodb://localhost:27017/selera-sambal

# MongoDB Atlas (production) — uncomment and replace with your Atlas URI:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/selera-sambal?retryWrites=true&w=majority

# JWT secret for table QR tokens (change in production)
JWT_SECRET=selera-sambal-qr-secret-key-2026
